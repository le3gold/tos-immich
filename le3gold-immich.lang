[en-us]
name = "Immich for TOS"
auth = "lee3gold"
descript = "Self-hosted photo and video library with timeline, albums, search and machine learning. This is an unofficial TOS 7 packaging of Immich 3.3.4; photos and metadata stay on your TNAS."
release_note = "1. First release based on Immich 3.3.4. Includes timeline, albums, upload, thumbnails, search, face detection and OCR."
important = "Requires DockerEngine. x86_64 only. The web UI uses port 2283. On first machine-learning use, about 1.7 GB of models are downloaded from hf-mirror.com and modelscope.cn. Docker applications cannot be upgraded in place; uninstall and reinstall to change versions. Uninstalling without deleting data keeps the library in /Volume*/DockerAppData/le3gold-immich."

